      "20": {"$type": "dimension", "$value": 20, "leading": "{typography.leading.body}", "tracking": "{typography.tracking.body-20}"},
      "16": {"$type": "dimension", "$value": 16, "leading": "{typography.leading.body}", "tracking": "{typography.tracking.body-16}"},
      "12": {"$type": "dimension", "$value": 12, "leading": "{typography.leading.body}"}
    },
    "caps": {
      "$source": [
        {"file": "SKILL.md", "section": "Typography"},
        {"file": "references/editorial-technique.md", "section": "2.3 Tracking"}

  "typography": {
    "$description": "Sizes are px and identical in EN and AR. Leading is a unitless multiple of the size. Tracking is % of the font size (Figma letter-spacing %), emitted as em. In AR every leading is the ar value and every tracking is 0.",
    "$source": [
      {"file": "SKILL.md", "section": "Typography"},
      {"file": "references/token-system.md", "section": "7. Tier 4 — Typography"}
